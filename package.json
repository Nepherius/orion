{
  "name": "orion",
  "version": "1.3.3",
  "description": "Entropia Universe Loot Tracker - Track your hunting sessions, loot, and returns",
  "type": "module",
  "homepage": "https://github.com/Nepherius/orion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nepherius/orion.git"
  },
  "bugs": {
    "url": "https://github.com/Nepherius/orion/issues"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:all",
    "test:react": "vitest run",
    "test:react:watch": "vitest",
    "test:unit": "npm run test:react",
    "test:unit:watch": "npm run test:react:watch",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm run test:react && npm run test:rust",
    "lint": "npm run lint:all",
    "lint:react": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:react:fix": "eslint . --ext ts,tsx --fix",
    "lint:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "lint:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint:rust:fix": "cargo clippy --manifest-path src-tauri/Cargo.toml --fix --allow-dirty --allow-staged",
    "lint:all": "npm run lint:react && npm run lint:rust && npm run lint:clippy",
    "lint:fix": "npm run lint:react:fix && npm run lint:rust:fix && npm run format:fix",
    "format": "npm run format:all",
    "format:check": "npm run format:all",
    "format:all": "npm run format:react:check && npm run format:rust:check",
    "format:react:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "format:fix": "npm run format:react:fix && npm run format:rust:fix",
    "format:react:fix": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:rust:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "check": "npm run check:all",
    "check:all": "npm run test:all && npm run lint:all && npm run format:all",
    "fix:all": "npm run lint:fix",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev-current.cjs",
    "tauri:build": "node scripts/tauri-build-current.cjs",
    "build:appimg": "npm run test:all && APPIMAGELAUNCHER_DISABLE=1 APPIMAGE_EXTRACT_AND_RUN=1 NO_STRIP=true tauri build --bundles appimage",
    "tauri:build:linux": "npm run test:all && APPIMAGELAUNCHER_DISABLE=1 APPIMAGE_EXTRACT_AND_RUN=1 NO_STRIP=true tauri build --bundles deb,rpm,appimage",
    "tauri:build:windows": "npm run test:all && tauri build --bundles msi,nsis",
    "build:linux": "npm run tauri:build:linux && npm run build:arch",
    "build:windows": "npm run tauri:build:windows",
    "prebuild": "node scripts/sync-version.cjs",
    "build:arch": "cd packaging/arch && makepkg -si"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-http": "^2.5.7",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "date-fns": "^3.0.6",
    "jstat": "^1.9.6",
    "lucide-react": "^0.316.0",
    "posthog-js": "^1.393.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^2.10.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^25.3.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.33",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^8.0.14",
    "vitest": "^4.0.18"
  }
}
